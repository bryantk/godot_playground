[gd_resource type="Resource" script_class="EnemyDef" format=3]

[ext_resource type="Script" path="res://code/battle/enemy_def.gd" id="1_enemy"]
[ext_resource type="Script" path="res://code/party/stats.gd" id="2_stats"]
[ext_resource type="Script" path="res://code/battle/ability.gd" id="3_ability"]
[ext_resource type="Resource" path="res://data/abilities/attack.tres" id="4_attack"]

[sub_resource type="Resource" id="Resource_stats"]
script = ExtResource("2_stats")

[resource]
script = ExtResource("1_enemy")
gold_reward = 2
id = &"new_enemy"
display_name = "New Enemy"
base_stats = SubResource("Resource_stats")
abilities = Array[ExtResource("3_ability")]([ExtResource("4_attack")])
